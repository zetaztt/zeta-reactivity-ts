{
	"name": "@zeta/reactivity",
	"version": "0.0.0-dev.0",
	"description": "一个与框架无关的 TypeScript 细粒度响应式库。",
	"type": "module",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"lint": "eslint .",
		"format": "dprint fmt",
		"format:check": "dprint check",
		"rules:generate": "rulesync generate",
		"rules:check": "rulesync generate --check",
		"test": "tsx --test \"test/*.test.ts\""
	},
	"devDependencies": {
		"@dprint/json": "^0.26.0",
		"@dprint/typescript": "^0.101.0",
		"@typescript-eslint/eslint-plugin": "^8.74.0",
		"@typescript-eslint/parser": "^8.74.0",
		"dprint": "^0.65.0",
		"eslint": "^10.15.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"rimraf": "^6.1.4",
		"rulesync": "43.9.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3"
	}
}
